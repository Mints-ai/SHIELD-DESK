{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test --import ./tests/setup.ts \"tests/*.test.ts\"",
    "test:sentry": "tsx scripts/trigger-sentry-event.ts",
    "setup:trivy": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_trivy.ps1",
    "setup:gitleaks": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_gitleaks.ps1",
    "setup:nats": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_nats.ps1",
    "agent:build": "powershell -ExecutionPolicy Bypass -Command \"Set-Location agent; go build -ldflags='-s -w' -o ../bin/shielddesk-agent.exe ./cmd; Set-Location ..\"",
    "agent:go": "bin\\shielddesk-agent.exe",
    "start:all": "powershell -ExecutionPolicy Bypass -File ./start.ps1"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.3.0",
    "is-extglob": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-types": "^4.1.0",
    "postgres-interval": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "xtend": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
