# Copy to .env.local and fill in real values.

# --- AI: local Ollama (no cloud API key — nothing leaves your infra) ---
# Requires Ollama running with a tool-calling-capable model pulled:
#   ollama pull qwen3:4b
#   ollama serve
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Database (Postgres) ---
# Schema + seed data: db/schema.sql, db/seed.sql (run both against a fresh
# database to get local dev users/incidents/assets).
DATABASE_URL=

# --- Python AI engine (Phase 5) ---
# Base URL for the existing vulnerability intelligence service (server.py).
# Real endpoints it exposes: GET /api/lookup?cve=..., POST /api/predict.
PYTHON_AI_SERVICE_URL=

# --- Auth ---
# No real identity provider yet — see lib/auth/session.ts. The widget
# sends an X-ShieldDesk-User header (a users.id value) instead of a
# verified token, until ShieldDesk has real login. Nothing to configure
# here for now.
