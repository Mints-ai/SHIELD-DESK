# Copy this file to .env.local and fill in your values.
# cp .env.example .env.local   (Mac/Linux)
# copy .env.example .env.local  (Windows)

# --- AI: local Ollama (no cloud API key --- nothing leaves your infra) ---
# Requires Ollama running with a tool-calling-capable model pulled:
#   ollama pull qwen3:4b
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Database (Supabase) ---
# Get these from your Supabase project dashboard -> Settings -> API.
# Run db/schema.sql and db/seed.sql in the Supabase SQL Editor first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# --- Python AI engine (optional) ---
# Only needed if you have the ai-chat-desk engine set up locally.
# Without this, CVE lookups will use built-in mock data automatically.
# PYTHON_AI_SERVICE_URL=http://localhost:8000
