# Copy to .env.local and fill in real values.

# --- AI: local Ollama (no cloud API key — nothing leaves your infra) ---
# Requires Ollama running with a tool-calling-capable model pulled:
#   ollama pull qwen3:4b
#   ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# --- Gemini AI (Cloud Analysis) ---
# Your Google Gemini API key for plain-English summaries, risk explanation, and mitigations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- NIST NVD API (National Vulnerability Database) ---
# Optional: request a free API key at https://nvd.nist.gov/developers/request-an-api-key
# Without a key: 5 requests per 30 seconds rolling window.
# With a key: 50 requests per 30 seconds rolling window.
NVD_API_KEY=

# --- Database (Postgres) ---
# Schema + seed data: db/schema.sql, db/seed.sql (run both against a fresh
# database to get local dev users/incidents/assets).
DATABASE_URL=postgresql://shielddesk:shielddesk_dev@localhost:5432/shielddesk

# --- Python AI engine (Phase 5) ---
# Base URL for the existing vulnerability intelligence service (server.py).
# Real endpoints it exposes: GET /api/lookup?cve=..., POST /api/predict.
PYTHON_AI_SERVICE_URL=http://localhost:8000

# --- Auth ---
# No real identity provider yet — see lib/auth/session.ts. The widget
# sends an X-ShieldDesk-User header (a users.id value) instead of a
# verified token, until ShieldDesk has real login. Nothing to configure
# here for now.
