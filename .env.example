# ==============================================================================
# ShieldDesk Autonomous SOC Platform — Environment Configuration
# ==============================================================================

# Core Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://shielddesk:shielddesk@localhost:5432/shielddesk

# Environment & Safety Boundary Modes
# APP_ENV: development | staging | production
APP_ENV=development
# DEMO_MODE: true (allows illustrative fallback data & dev personas) | false (enforces live fail-closed policy)
# Defaults to true in development, false in production
DEMO_MODE=true

# Python Vulnerability Intelligence Microservice (Port 8000)
PYTHON_AI_SERVICE_URL=http://localhost:8000

# Go Threat Detection & Anomaly Microservice (Port 8003)
THREAT_SERVICE_URL=http://localhost:8003

# Local or Private Enterprise Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional: Enterprise Supabase Authentication
# Leave empty for standalone local database authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic Session Secret (Required in production, minimum 32 chars)
SHIELDDESK_SESSION_SECRET=replace_with_minimum_32_character_random_secret_in_prod

# Cryptographic License & Evidence Vault Signing Secrets (Production)
SHIELDDESK_LICENSE_SECRET=
SHIELDDESK_VAULT_SECRET=
SHIELDDESK_WEBHOOK_SECRET=

# Live Ingestion API Key (Protects POST /api/ingest/webhooks)
SHIELDDESK_INGEST_API_KEY=sd_live_replace_with_secure_random_key_in_production

# External Attack Surface Management & Threat Intelligence (Optional)
# Add your API keys here to enable live perimeter scanning and domain breach disclosures
SHODAN_API_KEY=
HIBP_API_KEY=


# Enterprise Real-Time Alerting Channels
# Generates interactive notification cards for Tier 2/3 human authorization & error alerts
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SECURITY_WEBHOOK_URL=
ERROR_WEBHOOK_URL=

# Distributed Redis Cache (for multi-node production deployments)
REDIS_URL=redis://localhost:6379

# Enterprise Sentry Error & Performance Observability
# Paste your DSN from Sentry Project Settings -> Client Keys (e.g. mints-global organization)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ==============================================================================
# Commercial Stripe Billing & Licensing Service Configuration
# ==============================================================================
# Stripe Live / Test Mode API Keys (From Stripe Dashboard -> Developers -> API Keys)
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_signing_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_publishable_key

# Canonical Stripe Price IDs (Configured in Stripe Dashboard -> Product Catalogue)
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_replace_with_stripe_price_id_pro_month
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_replace_with_stripe_price_id_pro_year
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_replace_with_stripe_price_id_enterprise_month
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_replace_with_stripe_price_id_enterprise_year

# Commercial Licensing Key Hash Pepper (Separate from signing secrets, minimum 32 chars)
SHIELDDESK_LICENSE_PEPPER=replace_with_32_character_hex_pepper_for_license_digests

# Public Application Base URL (Used for Stripe Checkout redirect boundaries)
NEXT_PUBLIC_APP_URL=https://shielddesk.mintsglobal.ae
