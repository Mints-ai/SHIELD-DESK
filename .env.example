# ==============================================================================
# ShieldDesk Autonomous SOC Platform — Environment Configuration
# ==============================================================================

# Core Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://shielddesk:shielddesk@localhost:5432/shielddesk

# Python Vulnerability Intelligence Microservice (Port 8000)
PYTHON_AI_SERVICE_URL=http://localhost:8000

# Local or Private Enterprise Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional: Enterprise Supabase Authentication
# Leave empty for standalone local database authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic Session Secret (Required in production, minimum 32 chars)
SHIELDDESK_SESSION_SECRET=replace_with_minimum_32_character_random_secret_in_prod

# Live Ingestion API Key (Protects POST /api/ingest/webhooks)
SHIELDDESK_INGEST_API_KEY=sd_live_replace_with_secure_random_key_in_production


# Enterprise Real-Time Alerting Channels
# Generates interactive notification cards for Tier 2/3 human authorization
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SECURITY_WEBHOOK_URL=

# Distributed Redis Cache (for multi-node production deployments)
REDIS_URL=redis://localhost:6379
